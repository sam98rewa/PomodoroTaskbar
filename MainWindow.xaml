<Window x:Class="PomodoroTaskbar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pomodoro Taskbar"
        Width="440"
        Height="360"
        MinWidth="440"
        MinHeight="360"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Visibility="Visible">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="ModeText"
                   FontSize="22"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Text="WORK"/>

        <TextBlock x:Name="TimerText"
                   Grid.Row="1"
                   Margin="0,8,0,8"
                   FontSize="64"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Text="25:00"/>

        <ProgressBar x:Name="SessionProgress"
                     Grid.Row="2"
                     Height="8"
                     Minimum="0"
                     Maximum="100"/>

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">
                <Button x:Name="StartPauseButton"
                        Content="Start"
                        Width="110"
                        Height="40"
                        Margin="4"
                        Click="StartPause_Click"/>
                <Button Content="Reset"
                        Width="110"
                        Height="40"
                        Margin="4"
                        Click="Reset_Click"/>
                <Button Content="Skip"
                        Width="90"
                        Height="40"
                        Margin="4"
                        Click="Skip_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,18,0,0">
                <TextBlock Text="Work (min)"
                           VerticalAlignment="Center"
                           Margin="4"/>
                <TextBox x:Name="WorkBox"
                         Text="25"
                         Width="48"
                         Margin="4"/>

                <TextBlock Text="Break (min)"
                           VerticalAlignment="Center"
                           Margin="14,0,4,0"/>
                <TextBox x:Name="BreakBox"
                         Text="5"
                         Width="48"
                         Margin="4"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="4"
                   HorizontalAlignment="Center"
                   Foreground="Gray"
                   Text="Ready"/>
    </Grid>
</Window>